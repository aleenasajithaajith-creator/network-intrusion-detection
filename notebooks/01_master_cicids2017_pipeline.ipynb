    "# Step 2: Global Constants & Leakage Prevention Rules\n",
    "RANDOM_STATE = 42\n",
    "TARGET_COLUMN = 'Label'\n",
    "\n",
    "# Critical Interview Concept: Data Leakage Prevention\n",
    "# Never train an IDS on IP addresses or timestamps! Models will memorize specific IP addresses\n",
    "# rather than learning generalized malicious flow dynamics.\n",
    "LEAKAGE_COLUMNS = [\n",
    "    'Flow ID', 'Source IP', 'Src IP', 'Source Port', \n",
    "    'Destination IP', 'Dst IP', 'Timestamp', 'SimillarHTTP'\n",
    "]\n",
    "\n",
    "# Standardized 12-Class Mapping (Harmonizes sparse Web Attacks and Infiltration)\n",
    "LABEL_MAP = {\n",
    "    'BENIGN': 'BENIGN',\n",
    "    'DoS Hulk': 'DoS Hulk',\n",
    "    'PortScan': 'PortScan',\n",
    "    'DDoS': 'DDoS',\n",
    "    'DoS GoldenEye': 'DoS GoldenEye',\n",
    "    'FTP-Patator': 'FTP-Patator',\n",
    "    'SSH-Patator': 'SSH-Patator',\n",
    "    'DoS slowloris': 'DoS slowloris',\n",
    "    'DoS Slowhttptest': 'DoS Slowhttptest',\n",
    "    'Bot': 'Bot',\n",
    "    'Web Attack \x96 Brute Force': 'Web Attack',\n",
    "    'Web Attack – Brute Force': 'Web Attack',\n",
    "    'Web Attack - Brute Force': 'Web Attack',\n",
    "    'Web Attack \x96 XSS': 'Web Attack',\n",
    "    'Web Attack – XSS': 'Web Attack',\n",
    "    'Web Attack - XSS': 'Web Attack',\n",
    "    'Web Attack \x96 Sql Injection': 'Web Attack',\n",
    "    'Web Attack – Sql Injection': 'Web Attack',\n",
    "    'Web Attack - Sql Injection': 'Web Attack',\n",
    "    'Infiltration': 'Infiltration',\n",
    "    'Heartbleed': 'Infiltration'\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Data Ingestion & Memory Optimization\n",
    "# Define your dataset path (adjust to your Google Drive or local path)\n",
    "DATA_PATH = Path('/content/drive/MyDrive/CICIDS2017') if IN_COLAB else Path('../data/raw')\n",
    "\n",
    "def load_and_preprocess_file(file_path):\n",
    "    print(f\"Loading {file_path.name}...\")\n",
    "    df = pd.read_csv(file_path, low_memory=False)\n",
    "    df.columns = df.columns.str.strip()\n",
    "    \n",
    "    # Drop leakage columns early to save memory\n",
    "    drop_cols = [c for c in LEAKAGE_COLUMNS if c in df.columns]\n",
    "    df.drop(columns=drop_cols, inplace=True, errors='ignore')\n",
    "    \n",
    "    # Standardize Label\n",
    "    if TARGET_COLUMN in df.columns:\n",
    "        df[TARGET_COLUMN] = df[TARGET_COLUMN].astype(str).str.strip().map(LABEL_MAP).fillna(df[TARGET_COLUMN])\n",
    "    \n",
    "    # Replace +/- inf with NaN and drop missing\n",
    "    df.replace([np.inf, -np.inf], np.nan, inplace=True)\n",
    "    df.dropna(inplace=True)\n",
    "    \n",
    "    # Downcast datatypes to prevent Google Colab 12GB RAM crash\n",
    "    for col in df.select_dtypes(include=['float64']).columns:\n",
    "        df[col] = df[col].astype(np.float32)\n",
    "    for col in df.select_dtypes(include=['int64']).columns:\n",
    "        df[col] = df[col].astype(np.int32)\n",
    "        \n",
    "    return df\n",
    "\n",
    "# If working with single combined CSV or directory of CSVs:\n",
    "# df = load_and_preprocess_file(DATA_PATH / 'Thursday-WorkingHours-Morning-WebAttacks.pcap_ISCX.csv')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Feature Cleaning & Zero-Variance Elimination\n",
    "def finalize_feature_hygiene(df):\n",
    "    # Drop constant features\n",
    "    constant_cols = [c for c in df.columns if c != TARGET_COLUMN and df[c].nunique() <= 1]\n",
    "    print(f\"Dropping {len(constant_cols)} constant features: {constant_cols}\")\n",
    "    df = df.drop(columns=constant_cols)\n",
    "    \n",
    "    print(f\"Final clean dataset shape: {df.shape}\")\n",
    "    print(f\"Target class distribution:\\n{df[TARGET_COLUMN].value_counts()}\")\n",
    "    return df\n",
    "\n",
